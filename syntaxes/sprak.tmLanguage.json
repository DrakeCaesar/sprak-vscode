{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Sublime Sprak Syntax",
  "patterns": [
    {
      "comment": "Comment",
      "name": "comment.line.sprak",
      "match": "(#).*"
    },
    {
      "comment": "Keyword",
      "name": "keyword.control.sprak",
      "match": "\\b((end )?if|(end )?select|(resume )?next|case|end|void|close|do|else|for|gosub|goto|loop|on|open|return|then|to|until|while|in)\\b"
    },
    {
      "comment": "Operator",
      "name": "keyword.operator.sprak",
      "match": "(\\+|=|<|>|<>|AND|OR)"
    },
    {
      "comment": "Function",
      "name": "support.function.sprak",
      "match": "\\b(OnHack|OnIntruder|Count|Range|GetIndexes|Remove|RemoveAll|HasIndex|Append|Type|Round|Int|Mod|Info|Random|GetUser|Name|Time|Width|Height|GetHour|GetMinute|Sleep|Quit|CharToInt|IntToChar|ClearText|Print|Say|PlaySound|Pitch|Sin|Cos|PrintS|Input|Line|Text|Rect|DisplayGraphics|Color|Repeat|HSVtoRGB|RGBToHSV|Lines|GetConnections|Slurp|Connect|DisconnectAll|StringContains|MovePerson|ZapPerson|RestoreCode|Broadcast|IsKeyPressed|HasFloppy|LoadData|ClearData|SaveData|BootFromFloppy|SetMhz|EnableAPI|SetMaxTime|Speed|Charisma|Smelliness|Sleepiness|Drunkenness|Drink|Corruption|IsUser|GetRoom|RemoteFunctionCall|Trippy|TurnLeft|TurnRight|FastForward|Move|QuickBoost|Unlock|Lock|Toggle|Blip|GetChannel|SetChannel|TurnOffSound|TurnOnSound|Log|Position|Teleport|SetWorldPosition|GetThingsOfType|GetThingsInRoom|GetTypeOfThing|GetAllRooms|GetPeople|GetAction|GetMemories|GetPosition|%|AppendCode|ClearCode|ClearMemories|CopyToClipboard|EraseMemory|FindPath|GetCharisma|GetCode|GetLabel|GetName|GetSleepiness|GetSpeed|HD|HasMemory|IsNight|LoadMemory|SaveMemory|Sebastian|SetColor|SetLabel|SetLiquidAmount|TurnOff|TurnOn)\\b"
    },
    {
      "comment": "Function",
      "name": "entity.name.function.sprak",
      "match": "([a-zA-Z][a-zA-Z0-9_-]*) *\\("
    },
    {
      "comment": "Numeric",
      "name": "constant.numeric.sprak",
      "match": "\\b(\\d(\\.\\d)?)+"
    },
    {
      "comment": "Boolean Literal",
      "name": "constant.language.boolean.sprak",
      "match": "\\b(true|false)\\b"
    },
    {
      "comment": "Data Types",
      "name": "support.type.primitive.sprak",
      "match": "\\b(string|void|var|number|array|bool)\\b"
    },
    {
      "comment": "Global",
      "name": "constant.global.sprak",
      "match": "\\b\\w+\\$"
    },
    {
      "comment": "SUB",
      "name": "meta.function.sprak",
      "match": "^(\\w+):"
    },
    {
      "comment": "Brace, round",
      "name": "meta.brace.round.sprak",
      "match": "[\\(\\)]"
    },
    {
      "comment": "Brace, curly",
      "name": "meta.brace.curly.sprak",
      "match": "[\\{\\}]"
    },
    {
      "comment": "Array",
      "name": "other.array.sprak",
      "begin": "(\\w+\\()",
      "end": "(\\))",
      "patterns": [
        {
          "include": "$self"
        }
      ]
    },
    {
      "comment": "String, double-quoted",
      "name": "string.quoted.double.sprak",
      "match": "\"[^\"]*\""
    },
    {
      "comment": "String, single-quoted",
      "name": "string.quoted.single.sprak",
      "match": "'[^']*'"
    },
    {
      "comment": "Variable - starts with lowercase, may contain uppercase, numbers, underscore, dash, etc.",
      "name": "variable.other.mixed.sprak",
      "match": "\\b[a-zA-Z][a-zA-Z0-9_-]*\\b"
    }
  ],
  "repository": {},
  "scopeName": "source.sprak"
}
